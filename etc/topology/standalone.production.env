# standalone.production
SDKWORK_TERMINAL_DEPLOYMENT_PROFILE=standalone
SDKWORK_TERMINAL_ENVIRONMENT=production
SDKWORK_TERMINAL_PROFILE_ID=standalone.production


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TERMINAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_TERMINAL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:9620
SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:9620
VITE_SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:9620
SDKWORK_TERMINAL_PC_STATIC_ROOT=/usr/share/sdkwork/terminal/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://terminal.sdkwork.com,https://terminal.birdcoder.com,https://terminal.dtupay.com,https://terminal.noaper.com,https://terminal.sdkwork.cn,https://terminal.birdcoder.cn,https://terminal.dtupay.cn,https://terminal.noaper.cn,https://terminal.skubc.com,https://terminal.skubc.cn,https://terminal.zowalk.com,https://terminal.zowalk.cn,https://terminal.offer86.com,https://terminal.offer86.cn,https://terminal.86offer.com,https://terminal.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
