# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_terminal_demo` and a
# dedicated Redis prefix `terminal-demo` on a distinct logical DB index so no cache key collides with
# another env sharing the deployment Redis.
SDKWORK_TERMINAL_DEPLOYMENT_PROFILE=standalone
SDKWORK_TERMINAL_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_TERMINAL_PROFILE_ID=standalone.demo


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TERMINAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_TERMINAL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:9620
SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=https://terminal-demo.sdkwork.com

SDKWORK_TERMINAL_WEB_DEV_INGRESS_BIND=127.0.0.1:4596
SDKWORK_TERMINAL_PC_INTERNAL_DEV_PORT=4598
SDKWORK_TERMINAL_H5_INTERNAL_DEV_PORT=4599
VITE_SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:9620
SDKWORK_CORS_ALLOWED_ORIGINS=https://terminal-demo.sdkwork.com,http://terminal-demo.sdkwork.com,https://terminal-demo.birdcoder.com,http://terminal-demo.birdcoder.com,https://terminal-demo.dtupay.com,http://terminal-demo.dtupay.com,https://terminal-demo.noaper.com,http://terminal-demo.noaper.com,https://terminal-demo.sdkwork.cn,http://terminal-demo.sdkwork.cn,https://terminal-demo.birdcoder.cn,http://terminal-demo.birdcoder.cn,https://terminal-demo.dtupay.cn,http://terminal-demo.dtupay.cn,https://terminal-demo.noaper.cn,http://terminal-demo.noaper.cn,https://terminal-demo.skubc.com,http://terminal-demo.skubc.com,https://terminal-demo.skubc.cn,http://terminal-demo.skubc.cn,https://terminal-demo.zowalk.com,http://terminal-demo.zowalk.com,https://terminal-demo.zowalk.cn,http://terminal-demo.zowalk.cn,https://terminal-demo.offer86.com,http://terminal-demo.offer86.com,https://terminal-demo.offer86.cn,http://terminal-demo.offer86.cn,https://terminal-demo.86offer.com,http://terminal-demo.86offer.com,https://terminal-demo.86offer.cn,http://terminal-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
